[
  {
    match: "**/*",
    security_policy: "standard",
    headers: {
      // Override CSP del policy "standard":
      // - font-src: añadimos `data:` para @fontsource/roboto (fuentes embebidas base64)
      // - script-src: añadimos `'unsafe-eval'` para AJV (@rjsf/validator-ajv8) que usa new Function() al compilar schemas
      "Content-Security-Policy": "default-src 'self';script-src 'self' 'unsafe-eval';connect-src 'self' http://localhost:* https://icp0.io https://*.icp0.io https://icp-api.io;img-src 'self' data: blob:;style-src * 'unsafe-inline';style-src-elem * 'unsafe-inline';font-src * data:;object-src 'none';base-uri 'self';frame-ancestors 'none';form-action 'self';upgrade-insecure-requests;",
    },
  },
  {
    match: ".well-known/**/*",
    ignore: false,
    headers: {
      // El boundary node debe poder leer ic-domains sin cache intermedio.
      "Cache-Control": "no-cache, no-store, must-revalidate",
    },
  },
]
